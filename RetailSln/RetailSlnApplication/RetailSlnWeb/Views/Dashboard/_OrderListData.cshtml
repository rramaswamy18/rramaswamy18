@using ArchitectureLibraryCacheData
@using ArchitectureLibraryModels
@using RetailSlnCacheData
@using RetailSlnEnumerations
@using RetailSlnModels
@model OrderListModel
<style>
    .dataStyle {
        font-family: Arial;
        font-size: 12px;
    }

    .hrefStyle {
        color: #0000ff;
        font-family: Arial;
        font-size: 11px;
        font-weight: bold;
        text-decoration: underline;
    }
</style>
<table style="border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; margin-left: auto; margin-right: auto; padding: 5px; table-layout: auto; width: auto;">
    <tr>
        <th class="text-center" colspan="18" style="border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; color: #a54000; font-size: 18px; letter-spacing: 4px; text-transform: uppercase;">Order(s) List Not Viewed</th>
    </tr>
    <tr>
        <th style="border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; padding: 5px;">
            #
        </th>
        <th style="border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; padding: 5px;">
            Id
        </th>
        <th style="border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; padding: 5px;">
        </th>
        <th style="border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; padding: 5px;">
            Created For
        </th>
        <th style="border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; padding: 5px;">
            Created Date Time<br />
            Type<br />
            Tracking
        </th>
        <th style="border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; padding: 5px;">
            Order Amt<br />
            Addtl Chgs
        </th>
        <th style="padding: 5px;">
            Tax Amt<br />
            S&H
        </th>
        <th style="border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; padding: 5px;">
            Inv Amt<br />
            Paid<br />
            Balance
        </th>
        <th style="border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; padding: 5px;">
            Status
        </th>
    </tr>
    @{
        int i;
        for (i = 0; i < Model.OrderListDataModels.Count; i++)
        {
            if (Model.OrderListDataModels[i].OrderStatusId != OrderStatusEnum.OrderPlaced)
            {
                break;
            }
            Model.OrderListDataModels[i].Index = i + 1;
            @Html.Partial("_OrderEditData", Model.OrderListDataModels[i])
        }
    }
</table>
<table style="border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; margin-left: auto; margin-right: auto; padding: 5px; table-layout: auto; width: auto;">
    <tr>
        <th class="text-center" colspan="18" style="border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; color: #a54000; font-size: 18px; letter-spacing: 4px; text-transform: uppercase;">Order(s) List</th>
    </tr>
    <tr>
        <th style="border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; padding: 5px;">
            #
        </th>
        <th style="border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; padding: 5px;">
            Id
        </th>
        <th style="border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; padding: 5px;">
        </th>
        <th style="border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; padding: 5px;">
            Created For
        </th>
        <th style="border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; padding: 5px;">
            Created Date Time<br />
            Type<br />
            Tracking
        </th>
        <th style="border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; padding: 5px;">
            Order Amt<br />
            Addtl Chgs
        </th>
        <th style="padding: 5px;">
            Tax Amt<br />
            S&H
        </th>
        <th style="border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; padding: 5px;">
            Inv Amt<br />
            Paid<br />
            Balance
        </th>
        <th style="border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; padding: 5px;">
            Status
        </th>
    </tr>
    @{
        for (; i < Model.OrderListDataModels.Count; i++)
        {
            Model.OrderListDataModels[i].Index = i + 1;
            @Html.Partial("_OrderEditData", Model.OrderListDataModels[i])
        }
    }
</table>
