@using RetailSlnModels
@model ItemMasterDataModel
@{
    string addEditLabel;
    if (Model.ItemMasterModel.ItemMasterId == 0)
    {
        addEditLabel = "Add";
    }
    else
    {
        addEditLabel = "Edit #" + Model.ItemMasterModel.ItemMasterId;
    }
}
@*<div class="container">
</div>*@
<h2 style="color: #a54000; font-weight: bold;">Item Master (@addEditLabel)</h2>
<form id="formItemMasterData" method="post" enctype="multipart/form-data">
    @Html.Partial("_ItemMasterData", Model.ItemMasterModel)
</form>
<button class="loginRegisterbtn savebutton" id="itemMasterSave" onclick="javascript: return itemMasterSave_onclick();" style="letter-spacing: 9px; text-transform: uppercase;" type="button">save</button>
