<!--_DashboardHeader-->
@using ArchitectureLibraryCacheData
@using ArchitectureLibraryMenuModels
@using ArchitectureLibraryModels
@{
    //_DashboardHeader.cshtml
    #region Backend Code
    var clientId = ArchLibCache.ClientId;
    var clientName = ArchLibCache.ClientName;
    var imageTitle = ArchLibCache.GetApplicationDefault(clientId, "BusinessName1", "") + " | " + ArchLibCache.GetApplicationDefault(clientId, "BusinessType", "");
    SessionObjectModel sessionObjectModel = (SessionObjectModel)Session["SessionObject"];
    string aspNetRoleName = sessionObjectModel.AspNetRoleName;
    List<MenuUrlAction> menuUrlActions = new List<MenuUrlAction>
    {
        new MenuUrlAction
        {
            ActionName = "OrderList",
            ControllerName = "Dashboard",
            LinkText = "Order List",
            QueryString = "",
        },
        new MenuUrlAction
        {
            ActionName = "ItemCatalog",
            ControllerName = "Dashboard",
            FunctionNamesString = "parentCategoryId_onclick",
            LinkText = "Order Item",
            QueryString = "",
        },
        new MenuUrlAction
        {
            ActionName = "CorpAcctList",
            ControllerName = "Dashboard",
            LinkText = "Corp Acct",
            QueryString = "?pageNum=1&rowCount=45",
        },
        new MenuUrlAction
        {
            ActionName = "UserList",
            ControllerName = "Dashboard",
            LinkText = "User(s)",
            QueryString = "?pageNum=1&rowCount=45",
        },
        new MenuUrlAction
        {
            ActionName = "CategoryList",
            ControllerName = "Dashboard",
            LinkText = "Category",
            QueryString = "?id=",
        },
        new MenuUrlAction
        {
            ActionName = "ItemSpecMasterList",
            ControllerName = "Dashboard",
            LinkText = "Spec List",
            QueryString = "",
        },
        new MenuUrlAction
        {
            ActionName = "ItemMasterList",
            ControllerName = "Dashboard",
            //FunctionNamesString = "jQueryTextEditorInit",
            LinkText = "Item",
            QueryString = "?pageNum=1&rowCount=45",
        },
        new MenuUrlAction
        {
            ActionName = "SearchKeywordList",
            ControllerName = "Dashboard",
            LinkText = "Search Keywor(s)",
            QueryString = "",
        },
        new MenuUrlAction
        {
            ActionName = "CRMListList",
            ControllerName = "Dashboard",
            LinkText = "CRM",
            //QueryString = "?pageNum=1&rowCount=135",
            QueryString = "",
        },
    };
    int i;
    MenuUrlAction menuUrlAction;
    #endregion
}
<style>
    .customTopNav {
        background-color: #800000;
        overflow: hidden;
        position: sticky;
        top: 0px;
        width: 100%;
    }

        .customTopNav a {
            color: #ffffff;
            display: block;
            float: left;
            font-size: 14px;
            font-weight: 800;
            padding: 9px 7px;
            text-align: center;
            /*
                text-decoration: underline;
                text-decoration-thickness: 3px;
                text-underline-offset: 5px;
            */
        }

        .customTopNav .icon {
            display: none;
        }

    .customDropDown {
        float: left;
        overflow: hidden;
    }

        .customDropDown .customDropBtn {
            background-color: #800000;
            border: none;
            color: #ffffff;
            font-family: inherit;
            font-size: 15px;
            font-weight: bold;
            margin: 0;
            outline: none;
            padding: 9px 7px;
            width: 99px;
            /*
                text-decoration: underline;
                text-decoration-thickness: 3px;
                text-underline-offset: 5px;
            */
        }

    .customDropDown-content {
        background-color: #800000;
        box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);
        display: none;
        font-size: 15px;
        font-weight: bold;
        min-width: 160px;
        position: fixed;
        z-index: 1;
    }

        .customDropDown-content a {
            color: #ffffff;
            display: block;
            float: none;
            font-size: 14px;
            font-weight: 800;
            padding: 9px 7px;
            text-align: left;
            /*text-decoration: underline;*/
        }

    .customTopNav a:hover, .customDropDown:hover .customDropBtn {
        background-color: #8f0000;
        color: #ffffff;
    }

    .customDropDown-content a:hover {
        background-color: #8f0000;
        color: #ffffff;
    }

    .customDropDown:hover .customDropDown-content {
        display: block;
    }

    #divMenu {
        display: block;
    }

    #divMenuResponsive {
        display: none;
    }

    @@media screen and (max-width: 600px) {
        #divMenu {
            display: none;
        }

        #divMenuResponsive {
            display: block;
        }
    }
</style>
<div class="customTopNav" id="divMenu">
    @{
        i = 0;
        menuUrlAction = menuUrlActions[i];
        <a class="active" href="javascript: void(0);" style="">@menuUrlAction.LinkText</a>
        for (i = 1; i < 5; i++)
        {
            menuUrlAction = menuUrlActions[i];
            <a href="javascript: void(0);" onclick="javascript: return menuLink_onclick('@Url.Action(menuUrlAction.ActionName, menuUrlAction.ControllerName)', '@menuUrlAction.QueryString', '@menuUrlAction.FunctionNamesString');">@menuUrlAction.LinkText</a>
        }
    }
    <div class="customDropDown">
        <button class="customDropBtn">More...<i class="fa fa-caret-down" style="color: #ffffff;"></i></button>
        <div class="customDropDown-content">
            @for (; i < menuUrlActions.Count; i++)
            {
                menuUrlAction = menuUrlActions[i];
                <a href="javascript: void(0);" onclick="javascript: return menuLink_onclick('@Url.Action(menuUrlAction.ActionName, menuUrlAction.ControllerName)', '@menuUrlAction.QueryString', '@menuUrlAction.FunctionNamesString');">@menuUrlAction.LinkText</a>
            }
        </div>
    </div>
    <a alt="View Cart - @imageTitle" href="javascript: void(0);" style="padding-right: 0px; pointer-events: none;" title="View Cart - @imageTitle">
        <span id="shoppingCartItemsCount" style="display: none;">0</span>
        <span class="badge badge-warning shoppingCartItemsCount" id="shoppingCartTotalAmount" style="background-color: #9a031e;">$0.00</span>
    </a>
    <a href="javascript: void(0);" onclick="javascript: return shoppingCart_onclick(event);" style="padding-left: 0px;">View Cart</a>
    <a href="javascript: void(0);" onclick="javascript: return false;">Checkout</a>
    <a href="@Url.Action("Logout", "Home")">Logout</a>
    <a href="javascript: void(0);" style="color: #ffff00; cursor: auto; font-size: 12px; font-weight: 800; padding-left: 27px; text-decoration: none;">@ArchLibCache.GetApplicationDefault(clientId, "BusinessName1", "")</a>
</div>
<div class="customTopNav" id="divMenuResponsive" style="background-color: #800000;">
    <div style="padding-bottom: 3px;">
        <a alt="View Cart - @imageTitle" href="javascript: void(0);" style="padding-left: 0px; padding-right: 0px; pointer-events: none;" title="View Cart - @imageTitle">
            <span id="shoppingCartItemsCount1" style="display: none;">0</span>
            <span class="badge badge-warning shoppingCartItemsCount" id="shoppingCartTotalAmount1" style="background-color: #800000;">$0.00</span>
        </a>
        <a href="" style="padding-left: 1px; padding-right: 5px;">View Cart</a>
        <a href="" style="padding-left: 5px; padding-right: 5px;">Checkout</a>
        <a href="" style="padding-left: 5px; padding-right: 0px;">Logout</a>
        <a href="javascript: void(0);" style="color: #ffff00; cursor: auto; font-size: 10px; font-weight: 800; margin-top: 4px; padding-left: 19px; text-decoration: none;">@ArchLibCache.GetApplicationDefault(clientId, "BusinessName1", "")</a>
        <div style="float: right; margin: 0px; padding: 0px; vertical-align: top;">
            <a href="javascript: void(0);" onclick="myFunction()"><i class="fa fa-bars"></i></a>
        </div>
    </div>
    <br style="clear: both;" />
    <div id="divMenuResponsiveLink" style="display: block; padding: 0px;">
        <div style="float: left; padding-right: 9px; padding-top: 1px;">
            @{
                i = 0;
                menuUrlAction = menuUrlActions[i];
                <a class="active" href="javascript: void(0);" onclick="javascript: return menuLink_onclick('@Url.Action(menuUrlAction.ActionName, menuUrlAction.ControllerName)', '@menuUrlAction.QueryString', '@menuUrlAction.FunctionNamesString');" style="font-size: 12px; padding-bottom: 3px; pointer-events: none;">@menuUrlAction.LinkText</a>
                for (i = 1; i < 5 && i < menuUrlActions.Count; i++)
                {
                    <br style="clear: both;" />
                    menuUrlAction = menuUrlActions[i];
                    <a href="javascript: void(0);" onclick="javascript: return menuLink_onclick('@Url.Action(menuUrlAction.ActionName, menuUrlAction.ControllerName)', '@menuUrlAction.QueryString', '@menuUrlAction.FunctionNamesString');" style="font-size: 12px; padding-bottom: 3px;">@menuUrlAction.LinkText</a>
                }
            }
        </div>
        @if (i < menuUrlActions.Count)
        {
            <div style="float: left; padding-right: 9px; padding-top: 1px;">
                @{
                    for (; i < menuUrlActions.Count; i++)
                    {
                        menuUrlAction = menuUrlActions[i];
                        <a href="javascript: void(0);" onclick="javascript: return menuLink_onclick('@Url.Action(menuUrlAction.ActionName, menuUrlAction.ControllerName)', '@menuUrlAction.QueryString', '@menuUrlAction.FunctionNamesString');" style="font-size: 12px; padding-bottom: 3px;">@menuUrlAction.LinkText</a>
                        <br style="clear: both;" />
                    }
                }
            </div>
        }
        @if (i < menuUrlActions.Count)
        {
            <div style="float: left; padding-right: 9px; padding-top: 1px;">
                @{
                    for (; i < menuUrlActions.Count; i++)
                    {
                        menuUrlAction = menuUrlActions[i];
                        <a href="javascript: void(0);" onclick="javascript: return menuLink_onclick('@Url.Action(menuUrlAction.ActionName, menuUrlAction.ControllerName)', '@menuUrlAction.QueryString', '@menuUrlAction.FunctionNamesString');" style="font-size: 12px; padding-bottom: 3px;">@menuUrlAction.LinkText</a>
                        <br style="clear: both;" />
                    }
                }
            </div>
        }
    </div>
    <br style="clear: both;" />
</div>
<script>
    function myFunction() {
        if (document.getElementById("divMenuResponsiveLink").style.display === "block") {
            document.getElementById("divMenuResponsiveLink").style.display = "none";
        }
        else {
            document.getElementById("divMenuResponsiveLink").style.display = "block";
        }
        return false;
    }
</script>
