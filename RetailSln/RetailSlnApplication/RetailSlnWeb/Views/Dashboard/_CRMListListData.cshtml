@using ArchitectureLibraryCacheData
@using RetailSlnModels
@model CRMListListModel
@{
    int index;
}
<style>
    .dataStyle1Left {
        border-collapse: collapse;
        border-color: #000000;
        border-style: solid;
        border-width: 1px;
        font-family: Arial;
        font-size: 12px;
        padding: 5px;
        text-align: left;
    }

    .dataStyle1Right {
        border-collapse: collapse;
        border-color: #000000;
        border-style: solid;
        border-width: 1px;
        font-family: Arial;
        font-size: 12px;
        padding: 5px;
        text-align: right;
    }

    .dataStyle1Center {
        border-collapse: collapse;
        border-color: #000000;
        border-style: solid;
        border-width: 1px;
        font-family: Arial;
        font-size: 12px;
        padding: 5px;
        text-align: center;
    }

    .hrefStyle {
        color: #0000ff;
        font-family: Arial;
        font-size: 12px;
        font-weight: bold;
        text-decoration: underline;
    }
</style>
<table style="border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; margin-bottom: 0px; margin-left: auto; margin-right: auto; padding: 5px; width: auto;">
    <tr>
        <th style="border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; padding: 5px;"></th>
        <th style="border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; padding: 5px;"></th>
        <th style="border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; padding: 5px;"></th>
        <th style="border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; padding: 5px;"></th>
        <th style="border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; padding: 5px;">
            Mobile
        </th>
        <th style="border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; padding: 5px;">
            @Html.DropDownList("telephoneCountry", new SelectList(DemogInfoCache.DemogInfoCountrySelectListItems, "Value", "Text", null), "---", new { @class = "form-control", style = "float: left; font-size: 12px; width: 72%;" })
            Yes <input id="telephoneCountryEmpty1" name="telephoneCountryEmpty" type="radio" value="1" />
            No <input checked="checked" id="telephoneCountryEmpty2" name="telephoneCountryEmpty" type="radio" value="0" />
        </th>
        <th style="border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; padding: 5px;">
            <input class="form-control" id="telephoneNumber" style="float: left; width: 63%;" type="text" />
            Yes <input id="telephoneNumberEmpty1" name="telephoneNumberEmpty" type="radio" value="1" />
            No <input checked="checked" id="telephoneNumberEmpty2" name="telephoneNumberEmpty" type="radio" value="0" />
        </th>
        <th style="border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; padding: 5px; vertical-align: middle;">
            @Html.DropDownList("telephoneNumberValid", new SelectList(LookupCache.CodeTypeSelectListItems["YesNo"]["CodeDataNameId"], "Value", "Text", null), "---", new { @class = "form-control", style = "font-size: 12px;" })
        </th>
    </tr>
    <tr>
        <td colspan="3" class="dataStyle1Left" style="vertical-align: middle;">
            <select class="form-control" id="cRMListPageNum" onchange="javascript: return cRMListPageNum_onchange();">
                <option value="">-- Page# --</option>
                @for (index = 1; index < Model.TotalPageCount; index++)
                {
                    <option value="@index">@index</option>
                }
            </select>
        </td>
        <td class="dataStyle1Left" style="vertical-align: top;">
            <button class="btn btn-primary"  id="cRMListSearch" onclick="javascript: return cRMListSearch_onclick();" style="margin-top: 0px;">Search</button>
        </td>
        <td colspan="3" class="dataStyle1Left" style="vertical-align: top;">
            <button class="btn btn-primary" onclick="javascript: return cRMListPagePrev_onclick(@Model.PageNum);" style="margin-top: 0px;">Prev</button>
            <button class="btn btn-primary" onclick="javascript: return cRMListPageNext_onclick(@Model.PageNum, @Model.TotalPageCount);" style="margin-top: 0px;">Next</button>
            <span style="color: #0000ff; font-weight: bold; padding-left: 9px; padding-right: 9px;">Edit Count: </span><span id="editCount" style="color: #000000; font-weight: bold;">0</span>
            Page# @(Model.PageNum + "/" + Model.TotalPageCount) Rows @Model.TotalRowCount @(Model.RowCountFrom + " - " + Model.RowCountTo)
        </td>
        <td class="dataStyle1Left" style="vertical-align: top;">
            <button class="btn btn-primary" style="margin-top: 0px; width: 72px;">Save</button>
        </td>
    </tr>
    <tr>
        <th style="background-color: #d3d3d3; border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; padding: 5px;">#</th>
        <th style="background-color: #d3d3d3; border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; padding: 5px;">Id</th>
        <th style="background-color: #d3d3d3; border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; padding: 5px;">Code</th>
        <th style="background-color: #d3d3d3; border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; padding: 5px;">Name</th>
        <th style="background-color: #d3d3d3; border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; padding: 5px;">Mobile</th>
        <th style="background-color: #d3d3d3; border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; padding: 5px;">Country</th>
        <th style="background-color: #d3d3d3; border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; padding: 5px;">Phone#</th>
        <th style="background-color: #d3d3d3; border-collapse: collapse; border-color: #000000; border-style: solid; border-width: 1px; padding: 5px;">Valid</th>
    </tr>
    @{
        index = 0;
        foreach (var cRMListModel in Model.CRMListModels)
        {
            @Html.HiddenFor(m => cRMListModel.CRMListId)
            <tr>
                <td class="dataStyle1Right">@(index + 1).</td>
                <td class="dataStyle1Right">@cRMListModel.CRMListId</td>
                <td class="dataStyle1Left">@cRMListModel.CustomerCode</td>
                <td class="dataStyle1Left">@cRMListModel.CustomerName</td>
                <td class="dataStyle1Left">@cRMListModel.Mobile</td>
                <td class="dataStyle1Left">
                    @Html.HiddenFor(m => cRMListModel.TelephoneCountryIdSave, new { id = "cRMListModel_TelephoneCountryIdSave" + index })
                    @Html.DropDownListFor(m => cRMListModel.TelephoneCountryId, new SelectList(DemogInfoCache.DemogInfoCountrySelectListItems, "Value", "Text", cRMListModel.TelephoneCountryId), "---", new { @class = "form-control", id = "cRMListModel_TelephoneCountryId" + index, style = "font-size: 12px;" })
                </td>
                <td class="dataStyle1Left">
                    @Html.HiddenFor(m => cRMListModel.TelephoneNumberSave, new { id = "cRMListModel_TelephoneNumberSave" + index })
                    @Html.TextBoxFor(m => cRMListModel.TelephoneNumber, new { id = "cRMListModel_TelephoneNumber" + index, onchange = "javascript: calculateEditCount();" })
                    @if (!string.IsNullOrWhiteSpace(cRMListModel.TelephoneNumberError))
                    {
                        <br />
                    }
                    <span id="cRMListModel_TelephoneNumberError@(index)" style="color: #ff0000; font-weight: bold;">@cRMListModel.TelephoneNumberError</span>
                </td>
                <td class="dataStyle1Left">
                    @Html.HiddenFor(m => cRMListModel.TelephoneNumberValidSave, new { id = "cRMListModel_TelephoneNumberValidSave" + index })
                    @Html.DropDownListFor(m => cRMListModel.TelephoneNumberValid, new SelectList(LookupCache.CodeTypeSelectListItems["YesNo"]["CodeDataNameId"], "Value", "Text", cRMListModel.TelephoneNumberValid), "---", new { @class = "form-control", id = "cRMListModel_TelephoneNumberValid" + index, onchange = "javascript: calculateEditCount();", style = "font-size: 12px;" })
                </td>
            </tr>
            index++;
        }
    }
</table>
