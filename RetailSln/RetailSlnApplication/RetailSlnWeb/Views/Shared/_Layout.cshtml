<!--_Layout.cshtml-->
@using ArchitectureLibraryCacheData
@using ArchitectureLibraryModels
@using RetailSlnCacheData
@using RetailSlnModels
@{
    #region
    //DivineBija - 97, 98, 99
    var clientId = ArchLibCache.ClientId;
    var clientName = ArchLibCache.ClientName;
    var imageTitle = ArchLibCache.GetApplicationDefault(clientId, "BusinessName1", "") + " | " + ArchLibCache.GetApplicationDefault(clientId, "BusinessType", "");
    SessionObjectModel sessionObjectModel = (SessionObjectModel)Session["SessionObject"];
    bool isLoggedIn;
    if (sessionObjectModel == null)
    {
        isLoggedIn = false;
    }
    else
    {
        isLoggedIn = true;
    }
    isLoggedIn = isLoggedIn && User.Identity.IsAuthenticated;
    #endregion
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="author" content="Gajaashwa Inc." />
    <meta name="title" content="@ArchLibCache.GetApplicationDefault(clientId, "Head", "Title")" />
    <meta name="description" content="@ArchLibCache.GetApplicationDefault(clientId, "Head", "Description")" />
    <meta name="keywords" content="@ArchLibCache.GetApplicationDefault(clientId, "Head", "Keywords")" />
    <meta name="robots" content="index, follow" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="language" content="English" />
    <meta name="revisit-after" content="1 days" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ArchLibCache.GetApplicationDefault(clientId, "Head", "Title")</title>
    <link rel="shortcut icon" href="~/ClientSpecific/@(clientId)_@(clientName)/Documents/Images/Favicon.ico" />
    @Styles.Render("~/Content/css0")
    @Scripts.Render("~/bundles/scripts0")

    <link rel="stylesheet" href="~/Include/Site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Patua+One|Open+Sans|Lato|Roboto" />
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/4.4.0/css/font-awesome.min.css" />

    <link href="~/Include/font-awesome/css/all.css" rel="stylesheet" />
    <link href="~/Include/font-awesome/css/all.min.css" rel="stylesheet" />
    @RenderSection("scripts", required: false)
    <script type="text/javascript">
        $(document).ready(function () {
            window_onload();
        });
        function window_onload() {
            //$(".se-pre-con").fadeOut("slow");
            alert("Implement window on load in your page");
        }
        function myFunction(showElementId, hideElementId, menuResponsiveShowHide) {
            document.getElementById(showElementId).style.display = "block";
            document.getElementById(hideElementId).style.display = "none";
            document.getElementById("divMenuResponsive").style.display = menuResponsiveShowHide;
            return false;
        }
    </script>
</head>
<body>
    @*<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>*@
    <script src="~/Include/orderItemCode0.js" type="text/javascript"></script>
    <div id="divScrollIntoView"></div>
    <header class="header-section sticky">
        <div id="divHeaderTop" style="padding: 0px;">
            <div style="float: left;">
                <a class="navbar-right-link" href="@Url.Action("Index", "Home")">
                    <img alt="@imageTitle" src="~/ClientSpecific/@(clientId)_@(clientName)/Documents/Images/Image_000.webp" style="height: 117px; width: 117px;" title="@imageTitle" />
                </a>
            </div>
            <div style="float: left; padding-top: 27px;">
                <p class="company-name font-bold" style="vertical-align: top;">
                    <span style="color: #9401d9; font-size: 22px; font-weight: bold;">@ArchLibCache.GetApplicationDefault(clientId, "BusinessNameWord1", "")</span>
                    <span style="color: #ff0000; font-size: 14px; font-weight: bold;">@ArchLibCache.GetApplicationDefault(clientId, "BusinessNameWord2", "")</span><br /><span style="color: #000000; font-size: 14px; font-weight: bold;">@ArchLibCache.GetApplicationDefault(clientId, "BusinessNameWord3", "")</span>
                    <br style="clear: both;" />
                </p>
            </div>
            <div style="float: left; padding-left: 18px;">
                <div class="search-container">
                    <input id="searchTerm" class="search-input" placeholder="Search" type="text">
                    <button class="search-button" id="searchTermButton" onclick="javascript: return searchTermButton_onclick('searchTerm');">
                        <img alt="Search" src="https://static.vecteezy.com/system/resources/thumbnails/014/440/989/small/search-black-shadow-icon-socialicon-set-png.png" />
                    </button>
                </div>
                <div id="divErrorMessage" style="color: #ff0000; font-family: Arial; font-size: 12px; font-weight: bold;"></div>
            </div>
            <div style="float: right; padding-top: 9px;">
                <a href="@Url.Action("Index", "Home")" class="navbar-right-link" style="float: left; padding-right: 18px; text-align: center;">
                    <i class="fas fa-home"></i> <br />
                    Home
                </a>
                <a onclick="javascript: return shoppingCart_onclick(event);" href="javascript: void(0);" style="color: #333333; float: left; font-family: Arial, Helvetica, sans-serif; font-size: 14px; font-weight: 400; padding-right: 18px;" title="View Cart - @imageTitle">
                    <i class="fas fa-shopping-cart" style="color: #000; font-size: 15px"></i>
                    <span id="shoppingCartItemsCount" style="display: none;">0</span>
                    <span class="badge badge-warning shoppingCartItemsCount" id="shoppingCartTotalAmount" style="background-color: #9a031e;"></span>
                    <br />
                    <p class="text-overflow-ellipsis">View Cart</p>
                </a>
                <a class="navbar-right-link" id="hrfCheckoutLink" href="@Url.Action("Checkout", "Home")" style="float: left; padding-right: 18px; text-align: center;" title="Checkout - @imageTitle">
                    <img alt="Checkout - @imageTitle" src="~/Images/Checkout2.png" style="height: 20px; width: 20px;" title="Checkout - @imageTitle">
                    <br />
                    Checkout
                </a>
                <a class="navbar-right-link" href="@Url.Action("RegisterUserProf", "Home")" style="float: left; padding-right: 18px; text-align: center;" title="Register - @imageTitle">
                    <i class="fas fa-user-plus"></i>
                    <br />
                    Register
                </a>
                <a class="navbar-right-link @(isLoggedIn ? "disabled-link" : "")" href="@Url.Action("LoginUserProf", "Home")" style="float: left; padding-right: 18px; text-align: center;" title="Login / Sign In - @imageTitle">
                    <i class="fas fa-user"></i>
                    <br />
                    Sign In
                </a>
                <a class="navbar-right-link @(isLoggedIn ? "" : "disabled-link")" href="@Url.Action("Logout", "Home")" style="float: left; padding-right: 27px; text-align: center;" title="Logout - @imageTitle">
                    <i class="fas fa-sign-out-alt"></i>
                    <br />
                    Logout
                </a>
            </div>
            <br style="clear: both;" />
            @Html.Partial("_Header")
        </div>
        <div id="divHeaderTopResponsive" style="padding: 0px;">
            <div style="float: left;">
                <a class="navbar-right-link" href="@Url.Action("Index", "Home")">
                    <img alt="@imageTitle" src="~/ClientSpecific/@(clientId)_@(clientName)/Documents/Images/Image_000.webp" style="height: 63px; width: 63px;" title="@imageTitle" />
                </a>
            </div>
            <div style="float: left; padding-left: 9px;">
                <div class="search-container">
                    <input id="searchTermResponsive" class="search-input" placeholder="Search" type="text">
                    <button class="search-button" id="searchTermButton" onclick="javascript: return searchTermButton_onclick('searchTermResponsive');">
                        <img alt="Search" src="https://static.vecteezy.com/system/resources/thumbnails/014/440/989/small/search-black-shadow-icon-socialicon-set-png.png" />
                    </button>
                </div>
                <div id="divErrorMessage" style="color: #ff0000; font-family: Arial; font-size: 12px; font-weight: bold;"></div>
            </div>
            <br style="clear: both;" />
            <div style="align-items: center; background-color: #9a031e; display: flex; min-height: 50px; padding-left: 9px;">
                <div style="float: left;">
                    <a onclick="javascript: return shoppingCart_onclick(event);" href="javascript: void(0);" style="color: #ffffff; float: left; font-family: Arial, Helvetica, sans-serif; font-size: 12px; font-weight: bold; padding-right: 9px;" title="View Cart - @imageTitle">
                        View Cart
                        <br />
                        <span id="shoppingCartItemsCount1" style="display: none;">0</span>
                        <span class="badge badge-warning shoppingCartItemsCount" id="shoppingCartTotalAmount1" style="background-color: #ffffff; color: #9a031e;"></span>
                    </a>
                </div>
                <div style="float: left; ">
                    <a class="navbar-right-link" id="hrfCheckoutLink" href="@Url.Action("Checkout", "Home")" style="color: #ffffff; float: left; font-family: Arial, Helvetica, sans-serif; font-size: 12px; font-weight: bold; padding-right: 9px; text-align: center; display: inline-block; vertical-align: top; " title="Checkout - @imageTitle">
                        Checkout
                    </a>
                </div>
                <div style="float: left;">
                    <a href="@Url.Action("RegisterUserProf", "Home")" style="color: #ffffff; float: left; font-family: Arial, Helvetica, sans-serif; font-size: 12px; font-weight: bold; padding-right: 9px; text-align: center;" title="Register - @imageTitle">
                        Register
                    </a>
                </div>
                <div style="float: left;">
                    <a class="@(isLoggedIn ? "disabled-link" : "")" href="@Url.Action("LoginUserProf", "Home")" style="color: #ffffff; float: left; font-family: Arial, Helvetica, sans-serif; font-size: 12px; font-weight: bold; padding-right: 9px; text-align: center;" title="Login / Sign In - @imageTitle">
                        Sign In
                    </a>
                </div>
                <div style="float: left;">
                    <a href="javascript: void(0);" style="cursor: default; padding: 13px 0px;">
                        <span id="categoryNameSelectedA" style="color: #61ce70; font-size: 12px; font-weight: bold;"></span>
                    </a>
                </div>
                <div style="float: left; padding-left: 18px;">
                    <a href="javascript: void(0);" id="responsiveMenuBars" onclick="javascript: return myFunction('responsiveMenuTimes', 'responsiveMenuBars', 'block')"><i class="fa fa-bars" style="color: #ffffff; display: block;"></i></a>
                    <a href="javascript: void(0);" id="responsiveMenuTimes" onclick="javascript: return myFunction('responsiveMenuBars', 'responsiveMenuTimes', 'none')"><i class="fa fa-times" style="color: #ffffff; display: block;"></i></a>
                </div>
            </div>
            @Html.Partial("_HeaderResponsive")
            <script>
                myFunction('responsiveMenuBars', 'responsiveMenuTimes', 'none');
            </script>
        </div>
    </header>
    <div class="body-container">
        <div class="center main-body" style="padding: 0px; text-align: center; width: 100%; overflow-x: hidden;">
            <main role="main" class="pb-3" style="overflow-x: hidden; ">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" id="divOrderProcess">
                    @RenderBody()
                </div>
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12" id="divShoppingCart">
                    @Html.Partial("_ShoppingCartContainer")
                </div>
            </main>
        </div>
        @Html.Partial("_Footer")
    </div>
    @RenderSection("scripts", required: false)
    @Html.Partial("_LoadingModal")
</body>
</html>
