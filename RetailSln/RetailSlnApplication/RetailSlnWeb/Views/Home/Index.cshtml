@using RetailSlnModels
@model OrderItemModel
@{
    ViewBag.Title = "Index";
    PaymentInfoModel paymentInfoModel = (PaymentInfoModel)Session["PaymentInfo"];
    if (paymentInfoModel != null && paymentInfoModel.ShoppingCartModel != null)
    {
        paymentInfoModel.ShoppingCartModel.Checkout = false;
    }
}
@Html.Partial(Model.ViewName, Model)
<script type="text/javascript">
    function window_onload() {
        var menuCategoryItemId, menuCategoryItem;
        for (var count = 0; ; count++) {
            menuCategoryItemId = document.getElementById("menuCategoryId" + count);
            menuCategoryItem = document.getElementById("menuCategory" + count);
            if (menuCategoryItem === null) {
                break;
            }
            if (menuCategoryItemId.innerText === "@Model.ParentCategoryModel.CategoryId") {
                menuCategoryItem.classList.add("active_feature");
                menuCategoryItem = document.getElementById("menuCategoryA" + count);
                menuCategoryItem.classList.add("active_feature");
                document.getElementById("categoryNameSelected").innerHTML = "@Model.ParentCategoryModel.CategoryDesc";
                document.getElementById("categoryNameSelectedA").innerHTML = "@Model.ParentCategoryModel.CategoryDesc";
                break;
            }
        }
        shoppingCart_onclick();
        document.getElementById("divScrollIntoView").scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
</script>
