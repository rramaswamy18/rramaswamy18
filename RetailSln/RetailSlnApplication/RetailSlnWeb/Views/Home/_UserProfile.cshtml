@using ArchitectureLibraryModels
@model PersonModel
<div class="main">
    <div class="container">
        <div class="col-md-11" id="divUserProfile">
            <h2 style="text-align: center; width: 81%;">
                <span style="color: #a54000; font-size: 18px; font-weight: bold; letter-spacing: 9px; text-transform: uppercase;">USER PROFILE</span>
                <br />
                <input id="userProfileSave0" class="loginRegisterbtn" onclick="javascript: return userProfileSave_onclick();" style="font-size: 18px; font-weight: bold; letter-spacing: 9px; text-align: center; text-transform: uppercase; width: 45%;" type="button" value="save" />
            </h2>
            <form id="formUserProfileData">
                @Html.Partial("_UserProfileData", Model)
            </form>
            <h2 style="text-align: center; width: 81%;">
                <input id="userProfileSave1" class="loginRegisterbtn" onclick="javascript: return userProfileSave_onclick();" style="font-size: 18px; font-weight: bold; letter-spacing: 9px; text-align: center; text-transform: uppercase; width: 45%;" type="button" value="save" />
            </h2>
        </div>
    </div>
</div>
<br style="clear: both;" />
