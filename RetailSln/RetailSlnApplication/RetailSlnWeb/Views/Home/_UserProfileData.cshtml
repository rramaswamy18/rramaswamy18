@using ArchitectureLibraryCacheData
@using ArchitectureLibraryModels
@using RetailSlnCacheData
@model PersonModel
<style>
    #AspNetUserModel_Email-error, #CitizenshipId-error, #DateOfBirth-error, #DriverLicenseDemogInfoSubDivisionId-error,
    #DriverLicenseExpiryDate-error, #DriverLicenseNumber-error, #DriverLicenseType-error,
    #ElectronicSignatureConsentAccepted-error, #FirstName-error, #HomeDemogInfoAddressModel_AddressLine1-error,
    #HomeDemogInfoAddressModel_AddressLine2-error, #HomeDemogInfoAddressModel_BuildingTypeId-error,
    #HomeDemogInfoAddressModel_CityName-error, #HomeDemogInfoAddressModel_DemogInfoCountryId-error,
    #HomeDemogInfoAddressModel_DemogInfoSubDivisionId-error, #HomeDemogInfoAddressModel_ZipCode-error, #LastName-error,
    #MaritalStatusId-error, #MiddleName-error, #NicknameFirst-error, #NicknameLast-error, #SSN-error, #SalutationId-error,
    #SuffixId-error {
        color: #ff0000;
        display: block;
        font-size: 12px;
        font-weight: bold;
    }
</style>
@Html.HiddenFor(m => m.AspNetUserModel.AspNetUserId)
@Html.HiddenFor(m => m.AspNetUserModel.PhoneNumber)
@Html.HiddenFor(m => m.AspNetUserModel.TelephoneCountryId)
@Html.HiddenFor(m => m.PersonId)
@Html.HiddenFor(m => m.HomeDemogInfoAddressModel.DemogInfoAddressId)
@Html.HiddenFor(m => m.HomeDemogInfoAddressModel.DemogInfoCountryId)
@{
    DemogInfoCountryModel demogInfoCountryModel = DemogInfoCache.DemogInfoCountryModels.First(x => x.DemogInfoCountryId == Model.AspNetUserModel.TelephoneCountryId);
    string phoneNumberFormatted = "+" + demogInfoCountryModel.TelephoneCode + " " + long.Parse(Model.AspNetUserModel.PhoneNumber).ToString(demogInfoCountryModel.TelephoneFormat);
}
@{
    if (Model != null && Model.ResponseObjectModel != null && !string.IsNullOrWhiteSpace(Model.ResponseObjectModel.ValidationSummaryMessage))
    {
        <div class="row validationSummaryMessage" style="padding-left: 27px;">
            @Model.ResponseObjectModel.ValidationSummaryMessage
        </div>
    }
    if (!ViewData.ModelState.IsValid)
    {
        <div class="row" style="padding-left: 27px;">
            @Html.Raw(HttpUtility.HtmlDecode(Html.ValidationSummary(false, "", new { @class = "validationSummaryErrors", style = "-webkit-column-count: 3; -moz-column-count: 3; column-count: 3;  font-size: 12px; text-align: left;" }).ToHtmlString()))
        </div>
    }
    if (Model != null && Model.ResponseObjectModel != null)
    {
        <div class="row" style="padding-left: 27px;">
            @Html.Partial("_ResponseObject", Model.ResponseObjectModel)
        </div>
    }
}
