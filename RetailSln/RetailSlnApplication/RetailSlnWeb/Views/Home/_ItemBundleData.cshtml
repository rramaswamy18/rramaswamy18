@using ArchitectureLibraryCacheData
@using RetailSlnModels
@model ItemBundleDataModel
@{
    long clientId = ArchLibCache.ClientId;
    string clientName = ArchLibCache.ClientName;
    string imageTitle = ArchLibCache.GetApplicationDefault(clientId, "BusinessName1", "") + " | " + ArchLibCache.GetApplicationDefault(clientId, "BusinessType", "");
}
@{
    int index = 1, itemBundleItemIndex = -1;
    string itemBundleElementIndex;
    <table style="border-style: none; border-width: 0px; padding: 0px;">
        <tr>
            <td colspan="3" style="font-size: 12px; font-weight: bold; padding: 5px; vertical-align: top; ">
                <span style="color: #ff0000;">Order individual items from bundle</span>
                <span style="color: #a54000;">(#@Model.ParentItemBundleModel.ShoppingCartItemBundleModels.Count Items)</span>
            </td>
            <td style="color: #000000; font-size: 12px; font-weight: bold; padding: 5px; text-align: left; vertical-align: top;">
                <span id="itemBundleItemPiecesCount" style="color: #000000;">0</span>&nbsp;pieces
            </td>
            <td id="itemBundleItemRate" style="color: #000000; font-size: 12px; font-weight: bold; padding: 5px; text-align: right; vertical-align: top;">
                @(Model.CurrencySymbol + "0.00")
            </td>
            <td colspan="2" style="padding: 5px; vertical-align: top;">
                <input id="itemIdA" type="hidden" value="@Model.ParentItemBundleModel.ParentItemModel.ItemId" />
                <input id="orderQtyA" max="999" maxlength="3" min="1" type="hidden" value="1" />
                <span id="spnMessageSuccessA" style="display: none; font-family: Arial; font-size: 12px; font-weight: bold;">
                    <i class="fa fa-check" style="color: #00d000; padding-left: 7px; padding-right: 1px;"></i>
                    <span style="color: #a54000;">Added...<span id="spnMessageSuccessTextA" style="color: #0000ff; font-size:12px;"></span></span>
                    <br style="clear: both;" />
                </span>
                <span id="spnMessageErrorA" style="display: none; font-family: Arial; font-size: 12px; font-weight: bold;">
                    <i class="fa fa-remove" style="color: #ff0000; padding-left: 7px; padding-right: 1px;"></i>
                    <span id="spnMessageErrorTextA" style="color: #ff0000;"></span>
                    <br style="clear: both;" />
                </span>
            </td>
        </tr>
    </table>
    <table style="border-style: none; border-width: 0px; padding: 0px;">
        <tr style="background-color: #d0d0d0;">
            <th style="font-size: 12px; padding: 5px; text-align: right; vertical-align: top;">#</th>
            <th style="font-size: 12px; padding: 5px; text-align: center; vertical-align: top;">Id</th>
            <th style="font-size: 12px; padding: 5px; text-align: left; vertical-align: top;">Description</th>
            <th style="font-size: 12px; padding: 5px; text-align: right; vertical-align: top;">Price</th>
            <th style="font-size: 12px; padding: 5px; text-align: left; vertical-align: top;">Qty</th>
            <th style="font-size: 12px; padding: 5px; text-align: right; vertical-align: top;">Amount</th>
            <th></th>
        </tr>
        @foreach (ShoppingCartItemModel shoppingCartItemBundleModel in Model.ParentItemBundleModel.ShoppingCartItemBundleModels)
        {
            itemBundleItemIndex++;
            itemBundleElementIndex = "_" + Model.ParentItemBundleModel.ParentItemModel.ItemId + "_" + itemBundleItemIndex;
            <tr>
                <td style="font-size: 12px; padding: 5px; text-align: right; vertical-align: top;">@index.</td>
                <td style="font-size: 12px; padding: 5px; text-align: center; vertical-align: top;">@shoppingCartItemBundleModel.ItemId</td>
                <td style="font-size: 12px; padding: 5px; text-align: left; vertical-align: top;">
                    @(shoppingCartItemBundleModel.ItemMasterDesc0 + " " + shoppingCartItemBundleModel.ItemMasterDesc1)
                    @if (!string.IsNullOrWhiteSpace(shoppingCartItemBundleModel.ItemMasterDesc2 + " " + shoppingCartItemBundleModel.ItemMasterDesc3))
                    {
                        <br style="clear: both;" />
                        <span style="color: #1d1d1d; font-family: Arial; font-size: 12px; font-style: normal; font-weight: 600; line-height: 18px;">@(shoppingCartItemBundleModel.ItemMasterDesc2 + " " + shoppingCartItemBundleModel.ItemMasterDesc3)</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(shoppingCartItemBundleModel.ItemItemSpecsForDisplay))
                    {
                        <br style="clear: both;" />
                        <span style="color: #1d1d1d; font-family: Arial; font-size: 12px; font-style: normal; font-weight: 600;">@shoppingCartItemBundleModel.ItemItemSpecsForDisplay</span>
                    }
                </td>
                <td style="font-size: 12px; padding: 5px; text-align: right; vertical-align: top;">
                    @shoppingCartItemBundleModel.ItemRateFormatted
                </td>
                <td style="font-size: 12px; padding: 5px; text-align: left; vertical-align: top;">
                    <span id="itemIdForBundle@(itemBundleElementIndex)" style="display: none;">@shoppingCartItemBundleModel.ItemId</span>
                    <span id="itemRateForBundle@(itemBundleElementIndex)" style="display: none;">@shoppingCartItemBundleModel.ItemRate.Value</span>
                    <input class="form-control" id="orderQtyForBundle@(itemBundleElementIndex)" min="0" max="999" maxlength="3" name="orderQtyForBundle@(itemBundleElementIndex)" oninput="javascript: return orderQtyBundle_oninput(@Model.ParentItemBundleModel.ParentItemId, this, '', @Model.ParentItemBundleModel.ShoppingCartItemBundleModels.Count, '@Model.CurrencySymbol');" style="background-color: #e1e1e1; border-color: #000000; border-style: none; border-width: 1px; border-radius: 30px; width: 72px;" type="number" value="@shoppingCartItemBundleModel.OrderQty" />
                    <span id="spnMessageSuccessForBundle@(itemBundleElementIndex)" style="display: none; font-family: Arial; font-size: 12px; font-weight: bold;">
                        <br style="clear: both;" />
                        <i class="fa fa-check" style="color: #00d000; padding-left: 7px; padding-right: 1px;"></i>
                        <span style="color: #a54000;">Added...<span id="spnMessageSuccessTextForBundle@(itemBundleElementIndex)" style="color: #0000ff; font-size:12px;"></span></span>
                    </span>
                    <span id="spnMessageErrorForBundle@(itemBundleElementIndex)" style="display: none; font-family: Arial; font-size: 12px; font-weight: bold;">
                        <br style="clear: both;" />
                        <i class="fa fa-remove" style="color: #ff0000; padding-left: 7px; padding-right: 1px;"></i>
                        <span id="spnMessageErrorTextForBundle@(itemBundleElementIndex)" style="color: #ff0000;"></span>
                    </span>
                    <a href="javascript: void(0);" onclick="javascript: addToCart_onclick(document.getElementById('itemIdA').value, 'A', '1', false, true); resetItemBundleRate(@Model.ParentItemBundleModel.ParentItemId, '', @Model.ParentItemBundleModel.ShoppingCartItemBundleModels.Count, '@Model.CurrencySymbol');" title="Enter quantity and click add to cart @Model.ParentItemBundleModel.ParentItemModel.ItemMasterModel.ItemMasterDesc"><img alt="Enter quantity and click add to cart" src="~/Images/Addtocart.png" style="height: 36px; padding-left: 2px; width: 45px;" title="Enter quantity and click add to cart @Model.ParentItemBundleModel.ParentItemModel.ItemMasterModel.ImageTitle" /></a>
                </td>
                <td id="itemAmountForBundle@(itemBundleElementIndex)" style="font-size: 12px; padding: 5px; text-align: center; vertical-align: top;">
                </td>
                <td style="font-size: 12px; padding: 5px; text-align: center; vertical-align: top;">
                    <a href="@Url.Action("ItemMasterAttributes", "Home", new { id = Model.ParentItemBundleModel.ParentItemModel.ItemMasterModel.ItemMasterId, tabId = 0 })">
                        <img alt="@(shoppingCartItemBundleModel.ItemMasterDesc + " " + imageTitle)" src="~/ClientSpecific/@(clientId)_@(clientName)/Documents/Images/ItemMaster/@shoppingCartItemBundleModel.ImageName" style="height: 45px; width: 45px;" title="@(shoppingCartItemBundleModel.ItemMasterDesc + " " + imageTitle)" />
                    </a>
                </td>
            </tr>
            index++;
        }
    </table>
}
